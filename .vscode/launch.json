{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TB",
            "type": "debugpy",
            "request": "launch",
            "module": "tb.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "args": ["-p", "k", "-w", "32"]
        },
        {
            "name": "Debug Syn",
            "type": "debugpy",
            "request": "launch",
            "module": "syn.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "args": ["--project", "n", "--width", "48"]
        },
        {
            "name": "Debug Lint",
            "type": "debugpy",
            "request": "launch",
            "module": "lint.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src"
        }
    ]
}